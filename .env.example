# Copy this file to .env locally; never commit real credentials.
# Supply credentials only through protected local settings or environment variables.
# AMiner search is capability unavailable when AMINER_API_KEY is empty; it never falls back to embedded credentials.
AMINER_API_KEY=
AMINER_BASE_URL=https://datacenter.aminer.cn
GPT_IMAGE_API_KEY=
GPT_IMAGE_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
REVIEWER_MODEL_ID=